<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/mainLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">
    <!-- This is where the screen of the calculator will be -->
    <LinearLayout
        android:id="@+id/firstLayout"
        android:layout_width="match_parent"
        android:layout_height="55dp"
        style="@style/screenStyle"
        android:layout_weight="2"
        android:gravity="top"
        android:orientation="vertical">

        <TextView
            android:id="@+id/currentOperation"
            style="@style/screenText"
            android:layout_width="match_parent"
            android:layout_height="30dp"
            android:layout_weight="1"
            android:textSize="15sp"/>

        <TextView
            android:id="@+id/screen"
            style="@style/screenText"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_weight="2"
            android:textSize="20sp"/>

    </LinearLayout>
    <!-- M-, M+, Mc and Mr buttons -->
    <LinearLayout
        android:id="@+id/secondLayout"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_margin="4dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <Button
            android:id="@+id/BtnMinus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="M-"
            android:layout_marginEnd="10dp"
            style="@style/btnMCS"
            android:layout_weight="1"
            android:background="@drawable/button_shape_default"
            />
        <Button
            android:id="@+id/btnMSum"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="10dp"
            android:text="M+"
            style="@style/btnMCS"
            android:layout_weight="1"
            android:background="@drawable/button_shape_default"
            />
        <Button
            android:id="@+id/btnMc"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="10dp"
            android:text="Mc"
            style="@style/btnMCS"
            android:layout_weight="1"
            android:background="@drawable/button_shape_default"
            />
        <Button
            android:id="@+id/btnMr"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Mr"
            style="@style/btnMCS"
            android:layout_weight="1"
            android:background="@drawable/button_shape_default"
            />
    </LinearLayout>
    <!-- 7, 8, 9 and DEL buttons -->
    <LinearLayout
        android:id="@+id/thirdLayout"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_margin="4dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnSeven"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="10dp"
            android:text="7"
            style="@style/btnDefault"
            android:layout_weight="1"
            android:background="@drawable/button_shape_default"
            />
        <Button
            android:id="@+id/btnEight"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="10dp"
            android:text="8"
            style="@style/btnDefault"
            android:layout_weight="1"
            android:background="@drawable/button_shape_default"
            />
        <Button
            android:id="@+id/btnNine"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="10dp"
            android:text="9"
            style="@style/btnDefault"
            android:layout_weight="1"
            android:background="@drawable/button_shape_default"
            />
        <Button
            android:id="@+id/btnDelete"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="DEL"
            style="@style/btnDelete"
            android:layout_weight="1"
            android:background="@drawable/button_shape_default"
            />
    </LinearLayout>
    <!-- 4, 5, 6 and SUM buttons -->
    <LinearLayout
        android:id="@+id/fourthLayout"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_margin="4dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnFour"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="10dp"
            android:text="4"
            style="@style/btnDefault"
            android:layout_weight="1"
            android:background="@drawable/button_shape_default"
            />
        <Button
            android:id="@+id/btnFive"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="10dp"
            android:text="5"
            style="@style/btnDefault"
            android:layout_weight="1"
            android:background="@drawable/button_shape_default"
            />
        <Button
            android:id="@+id/btnSix"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="10dp"
            android:text="6"
            style="@style/btnDefault"
            android:layout_weight="1"
            android:background="@drawable/button_shape_default"
            />
        <Button
            android:id="@+id/btnSum"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="+"
            style="@style/btnOperations"
            android:layout_weight="1"
            android:background="@drawable/button_shape_default"
            />
    </LinearLayout>
    <!-- 1, 2, 3 and SURPLUS buttons -->
    <LinearLayout
        android:id="@+id/fifthLayout"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_margin="4dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnOne"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="10dp"
            android:text="1"
            style="@style/btnDefault"
            android:layout_weight="1"
            android:background="@drawable/button_shape_default"
            />
        <Button
            android:id="@+id/btnTwo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="10dp"
            android:text="2"
            style="@style/btnDefault"
            android:layout_weight="1"
            android:background="@drawable/button_shape_default"
            />
        <Button
            android:id="@+id/btnThree"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="10dp"
            android:text="3"
            style="@style/btnDefault"
            android:layout_weight="1"
            android:background="@drawable/button_shape_default"
            />
        <Button
            android:id="@+id/btnSurplus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="-"
            style="@style/btnOperations"
            android:layout_weight="1"
            android:background="@drawable/button_shape_default"
            />
    </LinearLayout>
    <!-- 0, 00, dot and MULTIPLY buttons -->
    <LinearLayout
        android:id="@+id/SixthLayout"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_margin="4dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnZero"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="10dp"
            android:text="0"
            style="@style/btnDefault"
            android:layout_weight="1"
            android:background="@drawable/button_shape_default"
            />
        <Button
            android:id="@+id/btnDoubleZero"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="10dp"
            android:text="00"
            style="@style/btnDefault"
            android:layout_weight="1"
            android:background="@drawable/button_shape_default"
            />
        <Button
            android:id="@+id/btnDot"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="10dp"
            android:text="."
            style="@style/btnDefault"
            android:layout_weight="1"
            android:background="@drawable/button_shape_default"
            />
        <Button
            android:id="@+id/btnMulti"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="X"
            style="@style/btnOperations"
            android:layout_weight="1"
            android:background="@drawable/button_shape_default"
            />
    </LinearLayout>

    <!-- RESULT and DIVISION buttons -->
    <LinearLayout
        android:id="@+id/seventhLayout"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_margin="4dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnResult"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="10dp"
            android:text="="
            android:layout_weight="1"
            style="@style/btnOperations"
            android:background="@drawable/button_shape_default"
            />
        <Button
            android:id="@+id/btnDivide"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="÷"
            android:layout_weight="1"
            style="@style/btnOperations"
            android:background="@drawable/button_shape_default"
            />
    </LinearLayout>

</LinearLayout>
