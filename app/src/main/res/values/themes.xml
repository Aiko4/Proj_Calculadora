<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.ProjCalculadora" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:windowBackground">@color/beige</item>
    </style>

    <style name="screenStyle">
        <item name="android:background">@color/black</item>
        <item name="android:padding">40dp</item>
        <item name="android:layout_marginTop">30dp</item>
        <item name="android:layout_marginLeft">10dp</item>
        <item name="android:layout_marginRight">10dp</item>
        <item name="android:textAlignment">textEnd</item>
    </style>

    <style name="screenText">
        <item name="android:textColor">@color/green</item>
    </style>

    <style name="btnDefault">
        <item name="backgroundTint">@color/dark</item>
    </style>

    <style name="btnMCS">
        <item name="backgroundTint">@color/darkBrown</item>
    </style>

    <style name="btnDelete">
        <item name="backgroundTint">@color/red</item>
        <item name="android:textColor">@color/white</item>
    </style>

    <style name="btnOperations">
        <item name="backgroundTint">@color/white2</item>
        <item name="android:textColor">@color/black</item>
    </style>

    <style name="Theme.ProjCalculadora" parent="Base.Theme.ProjCalculadora" />
</resources>